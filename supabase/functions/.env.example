# Copy to supabase/functions/.env for local development (gitignored).
# In production: npx supabase secrets set BILLING_WEBHOOK_SECRET=... SITE_URL=...
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by the runtime.

# Shared secret used to sign billing webhooks (long random string, e.g. openssl rand -hex 32).
BILLING_WEBHOOK_SECRET=change-me-local-only

# Default redirect URL in invitation e-mails (the app's accept-invitation page).
SITE_URL=http://127.0.0.1:3000
